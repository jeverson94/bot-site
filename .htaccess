# Rotas dinâmicas: /builds/<id>, /composicoes/ver/, /batalhas/<id>, /clipes/<id>
Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^builds/([^/]+)/?$ /builds/detalhe/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^composicoes/([^/]+)/?$ /composicoes/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^batalhas/([0-9]+)/?$ /batalhas/detalhe/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^clipes/([^/]+)/?$ /clipes/index.html [L]

# Ícone de item ainda não guardado no site: o PHP busca no render do Albion e grava.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^icone/([A-Za-z0-9_@~]+)\.webp$ /api/icone.php?f=$1 [L,QSA]

# Painel antigo: o backend ainda manda para /dashboard/config
RedirectMatch 302 ^/dashboard(/.*)?$ /painel/guildas/

# URLs em inglês equivalentes às páginas em PT-BR
RedirectMatch 301 ^/comps(/.*)?$ /composicoes$1
RedirectMatch 301 ^/battles/wars/?$ /batalhas/guerras/
RedirectMatch 301 ^/battles/meta/?$ /batalhas/meta/
RedirectMatch 301 ^/battles(/.*)?$ /batalhas$1
RedirectMatch 301 ^/guilds/?$ /guildas/
RedirectMatch 301 ^/create-event/?$ /criar-evento/
RedirectMatch 301 ^/map/?$ /mapa/
RedirectMatch 301 ^/season-points/?$ /pontos-temporada/
RedirectMatch 301 ^/market/?$ /mercado/
RedirectMatch 301 ^/clips(/.*)?$ /clipes$1
RedirectMatch 301 ^/games/?$ /jogos/
RedirectMatch 301 ^/about/?$ /sobre/
RedirectMatch 301 ^/contact/?$ /contato/
RedirectMatch 301 ^/terms/?$ /termos/
RedirectMatch 301 ^/privacy/?$ /privacidade/
RedirectMatch 301 ^/albion-downtime/?$ /manutencao-albion/
RedirectMatch 301 ^/features/events/?$ /recursos/eventos/
RedirectMatch 301 ^/features/builds/?$ /recursos/builds/
RedirectMatch 301 ^/features/signups/?$ /recursos/inscricoes/
RedirectMatch 301 ^/features/economy/?$ /recursos/economia/
RedirectMatch 301 ^/features/discord/?$ /recursos/discord/
RedirectMatch 301 ^/features/comps/?$ /recursos/inscricoes/
RedirectMatch 301 ^/recursos/?$ /recursos/eventos/
RedirectMatch 301 ^/vod-editor/?$ /vod-review/
RedirectMatch 301 ^/games/.+$ /jogos/
RedirectMatch 301 ^/auth/login/?$ /login/
RedirectMatch 301 ^/auth/sign-up/?$ /cadastro/

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# JS, CSS e dados mudam a cada deploy: cache curto no navegador.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|json|html)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  <FilesMatch "\.(webp|png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
